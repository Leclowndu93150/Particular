{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "${license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.leclowndu93150.particular.Main"
    ],
    "client": [
      "com.leclowndu93150.particular.Main"
    ],
    "modmenu": [
      "com.leclowndu93150.particular.config.ParticularModMenu"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "accessWidener": "particular.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "forgeconfigapiport": "*",
    "modmenu": "*",
    "java": ">=${java_version}"
  },
  "suggests": {
    "another-mod": "*"
  }
}
